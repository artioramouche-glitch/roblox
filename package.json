{
  "name": "roblox-ultimate-mcp-monorepo",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Roblox Ultimate MCP - lets ANY AI build complete Roblox games in Roblox Studio.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/embed-gamekit.mjs && npm run build -w packages/core && npm run build -w packages/roblox-ultimate-mcp && npm run build -w packages/roblox-ultimate-mcp-inspector",
    "prepare": "npm run build",
    "start": "node packages/roblox-ultimate-mcp/dist/index.js",
    "start:inspector": "node packages/roblox-ultimate-mcp-inspector/dist/index.js",
    "install-plugin": "node packages/roblox-ultimate-mcp/dist/index.js --install-plugin",
    "build:plugin": "node scripts/build-plugin.mjs",
    "build:plugin:inspector": "node scripts/build-plugin.mjs --variant inspector",
    "build:all": "npm run build && npm run build:plugin",
    "dev": "npm run build && tsx packages/roblox-ultimate-mcp/src/index.ts",
    "lint": "eslint packages/*/src/**/*.ts",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json",
    "test": "npm test -w packages/core",
    "gamekit:embed": "node scripts/embed-gamekit.mjs",
    "gamekit:verify": "node scripts/verify-gamekit-luau.mjs",
    "gamekit:docs": "node scripts/gen-gamekit-docs.mjs",
    "gamekit:smoke": "node scripts/gamekit-smoke.mjs",
    "gamekit:integration": "node scripts/gamekit-integration.mjs",
    "publish:all": "node scripts/publish.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/artioramouche-glitch/roblox.git"
  },
  "homepage": "https://github.com/artioramouche-glitch/roblox#readme",
  "bugs": {
    "url": "https://github.com/artioramouche-glitch/roblox/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1"
  }
}
