{
  "name": "roblox-ultimate-mcp-inspector",
  "version": "4.0.0",
  "description": "Read-only edition of Roblox Ultimate MCP (inspect places, guides, Luau checks; no writes).",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "roblox-ultimate-mcp-inspector": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "studio-plugin/**/*"
  ],
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/prepack.mjs",
    "postpack": "node ../../scripts/postpack.mjs"
  },
  "keywords": [
    "mcp",
    "roblox",
    "studio",
    "ai",
    "model-context-protocol",
    "inspector",
    "read-only"
  ],
  "author": "artioramouche-glitch (based on 6xvl/robloxstudio-mcp-server, MIT)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/artioramouche-glitch/roblox.git"
  },
  "homepage": "https://github.com/artioramouche-glitch/roblox#readme",
  "bugs": {
    "url": "https://github.com/artioramouche-glitch/roblox/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "roblox-ultimate-mcp-core": "4.0.0",
    "luau-web": "^1.4.0",
    "fzstd": "^0.1.1"
  }
}
